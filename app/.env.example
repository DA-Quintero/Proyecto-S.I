# ===========================================================================
# Credenciales de PRUEBA para el entorno de referencia P01 (Integrante 1)
# ---------------------------------------------------------------------------
# Copia este archivo a ".env" (sin extensión) en la misma carpeta:
#     Windows (PowerShell):  Copy-Item .env.example .env
#     Linux/macOS:           cp .env.example .env
#
# Son credenciales ficticias de un entorno local de pruebas. NO son datos
# reales ni secretos de producción. Aun así se cargan por variables de
# entorno (no quedan escritas en el código) y .env está excluido de Git.
# ===========================================================================

# Usuario A: propietario de 4 facturas ficticias (objetos "ajenos" para B).
APP_USER_A=alice
APP_PASS_A=Alice-Test-2026

# Usuario B: propietario de 1 factura; cuenta usada para la prueba de acceso.
APP_USER_B=bob
APP_PASS_B=Bob-Test-2026

# Parámetros de red de la app de referencia (opcionales).
APP_HOST=127.0.0.1
APP_PORT=8008
